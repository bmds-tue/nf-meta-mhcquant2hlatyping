manifest {
    name            = 'nf-meta-mhcquant2hlatyping'
    author          = 'jonas.scheid@uni-tuebingen.de'
    description     = 'Bridge connector: nf-core/mhcquant outputs -> nf-core/hlatyping immunotype samplesheet.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

params {
    mhcquant_outdir = null
    outdir          = '.'
    glob            = '*.tsv'
    seq_type        = 'peptide'
}
